# URL de l'API DALA. Laisser vide pour utiliser le mode démo (données simulées en mémoire).
EXPO_PUBLIC_API_URL=
# Forcer le mode démo même si une URL est définie
EXPO_PUBLIC_USE_MOCKS=false
# Suivi des erreurs (Sentry) et analytique (Mixpanel) — facultatifs
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MIXPANEL_TOKEN=
