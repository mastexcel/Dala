# URL de l'API DALA (obligatoire hors mode démonstration).
EXPO_PUBLIC_API_URL=
# Mode démonstration (données fictives) : réservé à l'APK de démonstration, refusé en production.
EXPO_PUBLIC_DEMO_MODE=false
# 'production' pour les versions remises aux utilisateurs.
EXPO_PUBLIC_APP_ENV=development
# Services hors UEMOA déclarés à l'ARTCI (sentry, mixpanel) : sans déclaration, ils restent inactifs.
EXPO_PUBLIC_FOREIGN_PROCESSORS_DECLARED=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MIXPANEL_TOKEN=
