# --- Serveur ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Base de données (PostgreSQL 16 / Supabase) ---
DATABASE_URL=postgresql://dala:dala@localhost:5432/dala?schema=public

# --- Auth ---
JWT_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# --- SMS (twilio | orange | console) ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=

# --- Redis / BullMQ (optionnel : sans Redis les tâches tournent en mémoire) ---
REDIS_URL=

# --- Service de scoring ML ---
ML_SERVICE_URL=http://localhost:8000

# --- Mobile Money (sandbox par défaut) ---
MOBILE_MONEY_MODE=sandbox
ORANGE_MONEY_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
WAVE_API_KEY=
MOOV_API_KEY=

# --- Stockage des pièces KYC : hébergeur d'Abidjan (compatible S3), données dans l'UEMOA ---
STORAGE_DRIVER=sandbox
STORAGE_BUCKET=kyc-documents
S3_ENDPOINT=
S3_REGION=ci-abidjan
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Services hors UEMOA : utilisés seulement s'ils sont déclarés à l'ARTCI (ex. sentry,fcm) ---
FOREIGN_PROCESSORS_DECLARED=

# --- Notifications push ---
FCM_SERVER_KEY=

# --- Conformité / back-office ---
ADMIN_API_KEY=change-me-admin-key
# Soldes des comptes de cantonnement (fournis par la banque partenaire, en FCFA)
SAFEGUARD_BALANCE_SAVINGS=0
SAFEGUARD_BALANCE_INVEST=0
SAFEGUARD_BALANCE_CROWDFUND=0
SAFEGUARD_BALANCE_MAIN=0

# --- Monitoring ---
SENTRY_DSN=
